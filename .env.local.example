# ============================================================
# INKOTANYI SINCE 90 — Local Environment Example
# Copy to .env.local and fill in real values.
# ============================================================

# ===== Admin =====
# Server-side admin password (used by /api/admin/login).
# Never add a NEXT_PUBLIC_ prefix — that would expose it to the browser.
ADMIN_PASSWORD=change-me-strong-password

# ===== MTN Mobile Money (Collections) =====
# Target environment: "sandbox" or your live environment value.
MTN_TARGET_ENVIRONMENT=sandbox

# Sandbox: https://sandbox.momodeveloper.mtn.com
# Live:    https://proxy.momoapi.mtn.com
MTN_API_BASE=https://sandbox.momodeveloper.mtn.com

# API user UUID + API user key from your MTN developer account
MTN_API_USER=your-api-user-uuid
# MERCHANT_ID=your-merchant-uuid   (alias for MTN_API_USER)
MTN_API_KEY=your-api-user-key

# MTN Collections product subscription key
MTN_SUBSCRIPTION_KEY=your-collections-subscription-key

# Currency for the environment (sandbox commonly EUR, live RWF)
MTN_CURRENCY=EUR

# Public callback URL to receive payment status updates
CALLBACK_URL=https://your-public-domain.com/api/payment/callback

# Optional callback secret token appended to the callback URL
MTN_CALLBACK_SECRET=

# Public base URL of the storefront
NEXT_PUBLIC_BASE_URL=https://your-public-domain.com

# ===== Supabase (PostgreSQL) — production persistence =====
# When these are set, orders, subscribers, and DNSMPI requests are stored in
# Supabase instead of local JSON files. The service-role key is SERVER-ONLY
# and must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix).
#
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy the project URL and service_role key here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
